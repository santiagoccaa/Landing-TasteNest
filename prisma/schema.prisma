// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OfferTargetType {
  PRODUCT
  COMBO
}

model Category {
  id        String    @id @default(uuid())
  name      String    @db.Text
  slug      String?   @unique @db.Text
  imageUrl  String?   @db.Text
  products  Product[] @relation("CategoryProducts")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([name])
}

model Feature {
  id              String           @id @default(uuid())
  name            String           @db.Text
  // Relación many-to-many con Product a través de ProductFeature
  productFeatures ProductFeature[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([name])
}

model Product {
  id              String           @id @default(ulid())
  name            String           @db.Text
  slug            String?          @unique @db.Text
  description     String           @db.Text
  price           Float // precio "base" del producto
  sku             String?          @db.Text
  stock           Int? // cantidad en inventario (opcional)
  imageUrl        String?          @db.Text
  isPublished     Boolean          @default(true)
  inOffer         Boolean          @default(false) // indicador rápido para UI
  category        Category?        @relation("CategoryProducts", fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId      String?
  // relación many-to-many a Features
  productFeatures ProductFeature[]
  // combos que incluyen este producto (a través de ComboItem)
  comboItems      ComboItem[]
  // ofertas aplicadas directamente al producto
  offers          Offer[]          @relation("ProductOffers")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([categoryId])
  @@index([name])
}

model ProductFeature {
  // tabla intermedia para la relación many-to-many Product <-> Feature
  id        String   @id @default(uuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  feature   Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)
  featureId String
  // opcional: prioridad u orden para mostrar la feature en UI
  priority  Int?
  createdAt DateTime @default(now())

  @@unique([productId, featureId])
  @@index([featureId])
  @@index([productId])
}

model Combo {
  id          String      @id @default(ulid())
  name        String      @db.Text
  slug        String?     @unique @db.Text
  description String?     @db.Text
  price       Float // precio del combo (establecido manualmente)
  isPublished Boolean     @default(true)
  // items que componen el combo (relación a productos)
  items       ComboItem[]
  // ofertas aplicadas al combo
  offers      Offer[]     @relation("ComboOffers")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([name])
}

model ComboItem {
  id        String  @id @default(uuid())
  combo     Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  comboId   String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId String
  quantity  Int     @default(1)
  // precio opcional por item (si necesitas sobreescribir)
  unitPrice Float
  // Nota: Prisma/DB no aplica reglas "exactamente 2 productos" aquí.
  // Esa restricción debe validarse a nivel de aplicación o con una migration SQL custom.

  @@index([comboId])
  @@index([productId])
}

model Offer {
  id          String          @id @default(uuid())
  title       String?         @db.Text
  description String?         @db.Text
  targetType  OfferTargetType
  // Relación opcional con Product o Combo (polimórfico controlado)
  product     Product?        @relation("ProductOffers", fields: [productId], references: [id], onDelete: Cascade)
  productId   String?
  combo       Combo?          @relation("ComboOffers", fields: [comboId], references: [id], onDelete: Cascade)
  comboId     String?
  offerPrice  Float
  discountPct Float? // ejemplo: 15.5 -> 15.5%
  startsAt    DateTime?
  endsAt      DateTime?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([targetType])
  @@index([startsAt, endsAt])
}
